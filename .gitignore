# Rust build output
/target/
target/
**/*.rs.bk

# Workspace lockfile policy: commit for the kernel workspace
# Cargo.lock stays tracked. The standalone user-binary
# workspaces (userspace/init, userspace/shell) generate their
# own lock files when verification/build.rs invokes cargo build
# against them — those are reproducible from a clean checkout
# and don't need to be tracked.
/userspace/init/Cargo.lock
/userspace/shell/Cargo.lock

# Cargo xtask artefacts
/build/out/
*.img
*.bin

# Editor / OS
*.swp
*.swo
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# QEMU runtime
*.qcow2
serial.log
qemu.log
.claude/

# Note: imported firmware blobs land at `target/firmware/` (default
# `xtask import-firmware --out`), already covered by `target/`
# above. The workspace `firmware/` dir is the narf-firmware crate
# itself and stays tracked.

# BusyBox demo: the build is owned by `verification/busybox`'s
# build.rs. All artefacts (source tarball, unpacked tree, built
# ELF) live in `target/.../build/narf-busybox-*/out/` and are
# covered by the `/target/` rule above. Nothing extra needed.
.semcode.*
.agents/
.mcp.json
